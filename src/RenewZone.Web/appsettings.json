{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=RenewZoneClone;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Uploads": {
    "Contact": {
      "MaxFileSizeMb": 5,
      "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".pdf" ],
      "FolderPath": "uploads/contact"
    },
    "Product": {
      "MaxFileSizeMb": 4,
      "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
      "FolderPath": "uploads/products"
    },
    "News": {
      "MaxFileSizeMb": 4,
      "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
      "FolderPath": "uploads/news"
    },
    "Banner": {
      "MaxFileSizeMb": 6,
      "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
      "FolderPath": "uploads/banners"
    },
    "Editor": {
      "MaxFileSizeMb": 4,
      "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
      "FolderPath": "uploads/editor"
    }
  }
}
