@model CategoryTreeNode
<div class="adm-tree-row" data-id="@Model.Id">
    <span class="adm-drag-handle" title="Kéo để đổi thứ tự" aria-hidden="true">
        <i class="bi bi-grip-vertical"></i>
    </span>

    @* Phương án bàn phím thay cho kéo-thả — kéo-thả thuần chuột là rào cản a11y điển hình *@
    <span class="adm-move-btns">
        <button type="button" class="js-move" data-dir="up" aria-label="Chuyển “@Model.Name” lên trên">▲</button>
        <button type="button" class="js-move" data-dir="down" aria-label="Chuyển “@Model.Name” xuống dưới">▼</button>
    </span>

    <span class="adm-tree-icon">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="" loading="lazy" />
        }
        else
        {
            <i class="bi @(Model.IconClass ?? "bi-folder")" aria-hidden="true"></i>
        }
    </span>

    <span class="adm-tree-name">
        <b>@Model.Name</b>
        @if (!Model.IsActive)
        {
            <span class="adm-badge adm-badge-muted ms-1">Đang ẩn</span>
        }
        <span class="adm-small adm-muted d-block adm-mono">/@Model.Slug</span>
    </span>

    <span class="adm-tree-count adm-small adm-muted">
        @if (Model.Children.Count > 0)
        {
            <text>@Model.Children.Count dòng · </text>
        }
        @Model.TotalProductCount sản phẩm
    </span>

    <label class="adm-switch" title="Hiện/ẩn trên website">
        <input type="checkbox" class="js-toggle-active" checked="@Model.IsActive"
               aria-label="Hiển thị “@Model.Name” trên website" />
        <span class="adm-switch-track"></span>
    </label>

    <span class="adm-row-actions">
        <a class="adm-act" href="/@Model.Slug" target="_blank" rel="noopener"
           title="Xem “@Model.Name” trên website">
            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
            <span class="visually-hidden">Xem trên website</span>
        </a>
        <a class="adm-act" asp-action="Edit" asp-route-id="@Model.Id" title="Sửa “@Model.Name”">
            <i class="bi bi-pencil" aria-hidden="true"></i>
            <span class="visually-hidden">Sửa</span>
        </a>
        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="d-inline">
            <button type="button" class="adm-act is-danger"
                    data-confirm="Danh mục <b>@Model.Name</b> sẽ được chuyển vào Thùng rác. Bạn có thể khôi phục lại sau."
                    data-confirm-title="Xóa danh mục?"
                    title="Xóa “@Model.Name”">
                <i class="bi bi-trash" aria-hidden="true"></i>
                <span class="visually-hidden">Xóa</span>
            </button>
        </form>
    </span>
</div>
