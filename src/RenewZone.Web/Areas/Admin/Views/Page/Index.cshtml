@model IReadOnlyList<StaticPageItem>
@{
    ViewData["Title"] = "Trang tĩnh";
}

<div class="adm-page-head">
    <div>
        <h1>Trang tĩnh</h1>
        <div class="adm-page-sub">
            Trang giới thiệu, chính sách, sửa chữa… — mỗi trang là một địa chỉ dạng /slug trên website.
        </div>
    </div>
    <div class="adm-page-actions">
        <a class="adm-btn adm-btn-primary" asp-action="Create">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            <span class="adm-btn-label">Thêm trang</span>
        </a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="adm-card">
        <partial name="_EmptyState" model='new EmptyStateModel {
            Icon = "bi-file-earmark-text", Title = "Chưa có trang tĩnh nào",
            Message = "Thêm trang mới là có ngay một địa chỉ trên website, không cần lập trình viên.",
            ActionText = "Thêm trang", ActionUrl = Url.Action("Create") }' />
    </div>
}
else
{
    <div class="adm-table-wrap">
        <table class="adm-table">
            <caption class="visually-hidden">Danh sách trang tĩnh</caption>
            <thead>
                <tr>
                    <th scope="col">Tiêu đề</th>
                    <th scope="col">Đường dẫn</th>
                    <th scope="col">Cập nhật lần cuối</th>
                    <th scope="col">Hiển thị</th>
                    <th scope="col" class="adm-col-actions">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a class="fw-bold" asp-action="Edit" asp-route-id="@item.Id">@item.Title</a></td>
                        <td class="adm-mono adm-small">/@item.Slug</td>
                        <td class="adm-small adm-muted">
                            @(item.UpdatedAt?.ToRelativeTime() ?? "chưa sửa lần nào")
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="adm-badge adm-badge-done">Đang hiện</span>
                            }
                            else
                            {
                                <span class="adm-badge adm-badge-muted">Đang ẩn</span>
                            }
                        </td>
                        <td class="adm-col-actions">
                            <span class="adm-row-actions">
                                <a class="adm-act" href="/@item.Slug" target="_blank" rel="noopener"
                                   title="Xem trên website">
                                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                    <span class="visually-hidden">Xem trên website</span>
                                </a>
                                <a class="adm-act" asp-action="Edit" asp-route-id="@item.Id" title="Sửa">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                    <span class="visually-hidden">Sửa</span>
                                </a>
                                <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline">
                                    <button type="button" class="adm-act is-danger"
                                            data-confirm="Trang <b>@item.Title</b> sẽ vào Thùng rác. Nếu có mục menu đang trỏ tới trang này thì link sẽ thành 404."
                                            data-confirm-title="Xóa trang?" title="Xóa">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                        <span class="visually-hidden">Xóa</span>
                                    </button>
                                </form>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
