@model ProductListViewModel
@{
    ViewData["Title"] = Model.Title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/product.css" asp-append-version="true" />
}

@await Html.PartialAsync("_Breadcrumb", new BreadcrumbViewModel { Items = new[] { new Crumb(Model.Title) } })

<div class="container">
    <header class="cat-head reveal">
        <h1 class="cat-title">@Model.Title</h1>
        <span class="cat-count">@Model.Results.TotalItems sản phẩm</span>
    </header>

    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 g-lg-4">
        @foreach (var p in Model.Results.Items)
        {
            <div class="col reveal">
                @await Html.PartialAsync("_ProductCard", p)
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", new PaginationViewModel
    {
        Page = Model.Results.Page,
        TotalPages = Model.Results.TotalPages,
        Url = Model.PageUrl
    })
</div>
