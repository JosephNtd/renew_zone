@using RenewZone.Infrastructure.Identity
@using RenewZone.Web.Helpers
@using RenewZone.Web.Models
@model ErrorViewModel
@{
    // 403 khi ĐANG đăng nhập là một tình huống rất khác các lỗi còn lại: không phải "hỏng" mà là
    // "sai tài khoản". Từ Giai đoạn 9 admin và khách dùng CHUNG một cookie, nên đăng nhập ở
    // /dang-nhap sẽ thay chỗ phiên quản trị — mở /admin sau đó là ra đây. Trang lỗi chung với ô
    // tìm kiếm sản phẩm chẳng giúp được gì; phải nói rõ đang đăng nhập bằng tài khoản nào và
    // cho sẵn lối ra.
    var wrongAccount = Model.StatusCode == 403 && User.Identity?.IsAuthenticated == true;

    ViewData["Title"] = wrongAccount ? "Không có quyền truy cập" : "Đã có lỗi xảy ra";
    ViewData["Seo"] = new SeoData { Title = ViewData["Title"] as string, NoIndex = true };
}

@if (wrongAccount)
{
    <div class="err404">
        <svg class="err404-ill" viewBox="0 0 240 190" fill="none" xmlns="http://www.w3.org/2000/svg" role="img"
             aria-label="Hình minh họa không có quyền truy cập">
            <defs>
                <linearGradient id="gLock" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#E183AF" />
                    <stop offset="1" stop-color="#96386B" />
                </linearGradient>
            </defs>
            <ellipse cx="120" cy="170" rx="86" ry="12" fill="#CE5F9A" opacity="0.10" />
            <rect x="72" y="88" width="96" height="68" rx="14" fill="url(#gLock)" />
            <path d="M92 88V70a28 28 0 0 1 56 0v18" stroke="#96386B" stroke-width="10" stroke-linecap="round" fill="none" />
            <circle cx="120" cy="118" r="9" fill="#fff" />
            <rect x="116" y="122" width="8" height="18" rx="4" fill="#fff" />
        </svg>

        <h1 class="err404-title reveal">Bạn không có quyền mở trang này</h1>
        <p class="err404-text reveal">
            Tài khoản <strong>@User.DisplayName()</strong> không được phép truy cập nội dung vừa yêu cầu.
            Nếu bạn cần vào khu quản trị, hãy đăng nhập bằng tài khoản có quyền @AppRoles.Admin.
        </p>

        <div class="err404-cta reveal">
            @* Đăng xuất là POST + anti-forgery; returnUrl đưa thẳng tới form đăng nhập quản trị
               để người dùng không phải tự mò đường sau khi đăng xuất. *@
            @* Hai phiên nay ĐỘC LẬP nên không cần đăng xuất khách để vào quản trị nữa —
               chỉ cần đi tới form đăng nhập quản trị. *@
            <a href="/admin/login" class="btn-rz btn-buy btn-lg">
                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập quản trị
            </a>
            <a href="/tai-khoan" class="btn-rz btn-cart-outline btn-lg my-1 mx-4">
                <i class="bi bi-person"></i> Về tài khoản của tôi
            </a>
        </div>
    </div>

    return;
}

<div class="err404">
    <svg class="err404-ill" viewBox="0 0 240 190" fill="none" xmlns="http://www.w3.org/2000/svg" role="img"
         aria-label="Hình minh họa có lỗi xảy ra">
        <defs>
            <linearGradient id="gGen" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#E183AF" />
                <stop offset="1" stop-color="#96386B" />
            </linearGradient>
        </defs>
        <ellipse cx="120" cy="170" rx="86" ry="12" fill="#CE5F9A" opacity="0.10" />
        <circle cx="120" cy="92" r="52" fill="#fff" stroke="#F0AACB" stroke-width="2.5" />
        <text x="120" y="108" text-anchor="middle" font-family="'Be Vietnam Pro',sans-serif" font-weight="800"
              font-size="46" fill="url(#gGen)">!</text>
    </svg>

    <h1 class="err404-title reveal">Có gì đó không ổn</h1>
    <p class="err404-text reveal">
        Yêu cầu của bạn không thực hiện được (mã @Model.StatusCode).
        Bạn thử quay lại trang chủ hoặc tìm lại thứ mình cần nhé.
    </p>

    <form class="search-pill err404-search reveal" action="/tim-kiem" method="get" role="search">
        <input type="search" name="q" placeholder="Tìm iPhone, MacBook, iPad..." aria-label="Tìm kiếm sản phẩm" />
        <button class="search-btn" type="submit" aria-label="Tìm kiếm"><i class="bi bi-search"></i></button>
    </form>

    <div class="err404-cta reveal">
        <a href="/" class="btn-rz btn-brand btn-lg">
            <i class="bi bi-house-door"></i> Về trang chủ
        </a>
    </div>
</div>
