@model ChangePasswordInput

<div class="acc-page-head">
    <h1 class="acc-page-title">Đổi mật khẩu</h1>
    <p class="acc-page-sub">Nên dùng mật khẩu riêng, không trùng với mật khẩu bạn dùng ở nơi khác.</p>
</div>

<div class="acc-card" style="max-width: 520px;">
    <form method="post" action="/tai-khoan/doi-mat-khau" asp-antiforgery="true">
        <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

        <div class="rz-field">
            <label class="co-label" asp-for="CurrentPassword"></label>
            <input class="rz-input" asp-for="CurrentPassword" autocomplete="current-password" />
            <span class="co-error" asp-validation-for="CurrentPassword"></span>
        </div>

        <div class="rz-field mt-3">
            <label class="co-label" asp-for="NewPassword"></label>
            <input class="rz-input" asp-for="NewPassword" autocomplete="new-password" />
            <span class="co-error" asp-validation-for="NewPassword"></span>
        </div>

        <div class="rz-field mt-3">
            <label class="co-label" asp-for="ConfirmPassword"></label>
            <input class="rz-input" asp-for="ConfirmPassword" autocomplete="new-password" />
            <span class="co-error" asp-validation-for="ConfirmPassword"></span>
        </div>

        <button class="btn-rz btn-buy mt-4" type="submit"><i class="bi bi-shield-check"></i> Đổi mật khẩu</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
