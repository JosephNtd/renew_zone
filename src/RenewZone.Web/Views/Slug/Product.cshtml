@using RenewZone.Web.Helpers
@model ProductDetail
@inject RenewZone.Domain.Interfaces.ISiteContentService SiteContent
@inject RenewZone.Domain.Interfaces.IWishlistService Wishlist
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name;
    ViewData["MetaDescription"] = p.ShortDescription;

    // ---- Tài khoản (Giai đoạn 9) ----
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var isFavorite = (await Wishlist.GetFavoriteIdsAsync(Context)).Contains(p.Id);

    // Controller đã tra "tài khoản này đã mua sản phẩm chưa" (SlugController.ProductView).
    // Chỉ dùng để hiện/ẩn form cho đúng — chốt chặn thật ở ReviewController.
    var canReview = ViewData["CanReview"] as bool? ?? false;
    var hasReviewedAll = ViewData["HasReviewedAll"] as bool? ?? false;

    var images = p.Images.Count > 0
        ? p.Images.ToList()
        : new List<ProductImage> { new() { Url = "/images/placeholder-product.svg", IsMain = true } };
    var mainImg = images.FirstOrDefault(i => i.IsMain) ?? images[0];

    var settings = await SiteContent.GetSettingsAsync();
    var hotline = settings.GetValueOrDefault(SettingKeys.Hotline) ?? "";
    var hotlineTel = "tel:" + hotline.Replace(".", "").Replace(" ", "");

    int? discountPct = p.HasDiscount
        ? (int)Math.Round((1 - (double)(p.SalePrice!.Value / p.OriginalPrice)) * 100)
        : null;

    var crumbs = new List<Crumb> { new("Sản phẩm", "/san-pham") };
    if (Model.ParentCategory is not null)
    {
        crumbs.Add(new Crumb(Model.ParentCategory.Name, $"/{Model.ParentCategory.Slug}"));
    }
    crumbs.Add(new Crumb(p.Name));

    // ---- SEO (Giai đoạn 7) ----
    ViewData["Seo"] = new SeoData
    {
        Title = p.Name,
        Description = p.ShortDescription,
        CanonicalPath = $"/{p.Slug}",
        OgImage = mainImg.Url,
        OgType = "product"
    };

    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var productUrl = $"{origin}/{p.Slug}";
    var jsonProduct = StructuredData.Product(
        p.Name, p.ShortDescription, images.Select(i => origin + i.Url),
        p.SalePrice ?? p.OriginalPrice, p.IsContactPrice, productUrl);

    var breadcrumbLd = new List<(string, string)> { ("Trang chủ", origin + "/"), ("Sản phẩm", origin + "/san-pham") };
    if (Model.ParentCategory is not null)
    {
        breadcrumbLd.Add((Model.ParentCategory.Name, $"{origin}/{Model.ParentCategory.Slug}"));
    }
    breadcrumbLd.Add((p.Name, productUrl));
    var jsonBreadcrumb = StructuredData.Breadcrumb(breadcrumbLd);
}

@* JSON-LD structured data — rich result (giá + ảnh trong kết quả Google) *@
@Html.JsonLd(jsonProduct)
@Html.JsonLd(jsonBreadcrumb)

@section Styles {
    <link rel="stylesheet" href="~/lib/swiper/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/product.css" asp-append-version="true" />
}

@await Html.PartialAsync("_Breadcrumb", new BreadcrumbViewModel { Items = crumbs })

<div class="container">
    <div class="pdp-grid">
        @* GALLERY *@
        <div class="pdp-gallery reveal">
            <div class="pdp-stage">
                @* Ảnh chính PDP là LCP: eager + fetchpriority cao, KHÔNG lazy *@
                <img id="pdpMainImg" src="@mainImg.Url" alt="@p.Name" width="800" height="800"
                     loading="eager" fetchpriority="high" decoding="async" />
            </div>
            @if (images.Count > 1)
            {
                <div class="pdp-thumbs">
                    @foreach (var img in images)
                    {
                        <button type="button" class="pdp-thumb @(img == mainImg ? "is-active" : "")" data-src="@img.Url" aria-label="Ảnh @p.Name">
                            <img src="@img.Url" alt="@p.Name" width="72" height="72" loading="lazy" decoding="async" />
                        </button>
                    }
                </div>
            }
        </div>

        @* MUA HÀNG *@
        <div class="pdp-buy reveal">
            <h1 class="pdp-name">@p.Name</h1>

            <div class="pdp-meta">
                @if (p.IsInstallment0Percent)
                {
                    <span class="badge-installment">Trả góp 0%</span>
                }
                @if (discountPct is > 0)
                {
                    <span class="badge-off">-@discountPct%</span>
                }
            </div>

            @if (p.IsContactPrice)
            {
                <div class="pdp-price-box">
                    <span class="badge-contact pdp-contact">Liên hệ</span>
                </div>
                <a class="btn-rz btn-buy btn-lg pdp-call" href="@hotlineTel"><i class="bi bi-telephone-fill"></i> Gọi @hotline để được tư vấn</a>
            }
            else
            {
                <div class="pdp-price-box" data-price-base="@p.DisplayPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    @if (p.HasDiscount)
                    {
                        <span class="pdp-price-old">@p.OriginalPrice.ToVnd()</span>
                    }
                    <span class="pdp-price-now" id="pdpPrice">@p.DisplayPrice.ToVnd()</span>
                </div>

                @* VARIANT SELECTOR *@
                @if (p.OptionGroups.Count > 0)
                {
                    <div class="pdp-options">
                        @foreach (var g in p.OptionGroups)
                        {
                            var defaultVal = g.Values.FirstOrDefault(v => v.IsDefault) ?? g.Values.FirstOrDefault();
                            <div class="pdp-optgroup" data-group="@g.Attribute.Name">
                                <span class="pdp-optlabel">@g.Attribute.Name</span>
                                <div class="pdp-optvalues" role="group" aria-label="@g.Attribute.Name">
                                    @foreach (var v in g.Values)
                                    {
                                        <button type="button"
                                                class="pdp-opt @(v == defaultVal ? "is-active" : "")"
                                                data-value-id="@v.Id"
                                                data-adjust="@v.PriceAdjustment.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-value="@v.AttributeValue.Value">
                                            @v.AttributeValue.Value
                                            @if (v.PriceAdjustment != 0)
                                            {
                                                <span class="pdp-opt-delta">@(v.PriceAdjustment > 0 ? "+" : "")@v.PriceAdjustment.ToVnd()</span>
                                            }
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="pdp-qty">
                    <span class="pdp-qty-label">Số lượng</span>
                    <div class="rz-stepper" id="pdpQty" data-max="@CartService.MaxQuantityPerItem">
                        <button type="button" class="step-btn js-pdp-step" data-step="-1"
                                aria-label="Giảm số lượng" disabled>
                            <i class="bi bi-dash"></i>
                        </button>
                        <span class="step-val" aria-live="polite">1</span>
                        <button type="button" class="step-btn js-pdp-step" data-step="1" aria-label="Tăng số lượng">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>
                </div>

                <div class="pdp-actions">
                    <button type="button" class="btn-rz btn-cart-outline btn-lg pdp-addcart"
                            data-product-id="@p.Id" data-product-name="@p.Name">
                        <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                    </button>
                    <button type="button" class="btn-rz btn-buy btn-lg pdp-buynow"
                            data-product-id="@p.Id" data-product-name="@p.Name">
                        Mua ngay
                    </button>

                    @* Nút ♡ (Giai đoạn 9) — khách vãng lai bấm sẽ mở hộp thoại đăng nhập *@
                    <button class="js-wishlist pdp-fav @(isFavorite ? "is-on" : "")" type="button"
                            data-product-id="@p.Id"
                            aria-pressed="@(isFavorite ? "true" : "false")"
                            aria-label="@(isFavorite ? "Bỏ yêu thích" : "Thêm vào yêu thích")">
                        <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart")"></i>
                    </button>
                </div>

                <a class="pdp-hotline-line" href="@hotlineTel">
                    <i class="bi bi-headset"></i> Tư vấn nhanh: <strong>@hotline</strong>
                </a>
            }

            @* CAM KẾT (nội dung từ bảng ContentBlocks — rỗng thì tự ẩn) *@
            @await Component.InvokeAsync("ContentBlocks",
                new { groupKey = ContentBlockGroups.ProductCommitments, cssClass = "pdp-commit" })
        </div>
    </div>

    @* TABS NỘI DUNG *@
    <div class="pdp-tabs reveal">
        <div class="pdp-tabbar" role="tablist">
            @if (!string.IsNullOrWhiteSpace(p.SpecsHtml))
            {
                <button type="button" class="pdp-tab is-active" data-tab="specs" role="tab">Thông số kỹ thuật</button>
            }
            @if (!string.IsNullOrWhiteSpace(p.DescriptionHtml))
            {
                <button type="button" class="pdp-tab @(string.IsNullOrWhiteSpace(p.SpecsHtml) ? "is-active" : "")" data-tab="desc" role="tab">Mô tả sản phẩm</button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(p.SpecsHtml))
        {
            <div class="pdp-panel prose is-active" data-panel="specs">@Html.Raw(p.SpecsHtml)</div>
        }
        @if (!string.IsNullOrWhiteSpace(p.DescriptionHtml))
        {
            <div class="pdp-panel prose @(string.IsNullOrWhiteSpace(p.SpecsHtml) ? "is-active" : "")" data-panel="desc">@Html.Raw(p.DescriptionHtml)</div>
        }
        @if (string.IsNullOrWhiteSpace(p.SpecsHtml) && string.IsNullOrWhiteSpace(p.DescriptionHtml))
        {
            <p class="pdp-noinfo">Thông tin chi tiết đang được cập nhật.</p>
        }
    </div>

    @* ĐÁNH GIÁ & BÌNH LUẬN — section riêng, không phải tab *@
    <section class="pdp-reviews reveal" id="danh-gia" data-product-id="@p.Id">
        <div class="rv-head">
            <h2 class="rv-title">Đánh giá &amp; bình luận</h2>
            @if (p.ReviewCount > 0)
            {
                <div class="rv-summary">
                    <span class="rv-score">@p.AvgRating.ToString("0.0")</span>
                    @await Html.PartialAsync("_StarRating", p.AvgRating)
                    <span class="rv-count">@p.ReviewCount đánh giá</span>
                </div>
            }
        </div>

        @* Danh sách đánh giá đã duyệt *@
        <div class="rv-list">
            @if (Model.Reviews.Count == 0)
            {
                <p class="rv-empty">Chưa có đánh giá nào. Hãy là người đầu tiên đánh giá sản phẩm này!</p>
            }
            else
            {
                @foreach (var rv in Model.Reviews)
                {
                    <article class="rv-item">
                        <div class="rv-item-head">
                            <span class="rv-avatar" aria-hidden="true">@(rv.AuthorName.Trim().Length > 0 ? rv.AuthorName.Trim()[..1].ToUpper() : "?")</span>
                            <div>
                                <div class="rv-author">
                                    @rv.AuthorName
                                    @if (rv.IsVerifiedPurchase)
                                    {
                                        @* Huy hiệu là giá trị cốt lõi của việc bắt đăng nhập:
                                           người đọc biết đây là nhận xét của người thật sự đã mua.
                                           Cờ được chốt lúc gửi đánh giá, không tính lại lúc hiển thị. *@
                                        <span class="rv-verified" title="Đã mua sản phẩm này tại shop">
                                            <i class="bi bi-patch-check-fill" aria-hidden="true"></i> Đã mua hàng
                                        </span>
                                    }
                                </div>
                                <div class="rv-meta">
                                    @await Html.PartialAsync("_StarRating", (decimal)rv.Rating)
                                    <span class="rv-date">@rv.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        </div>
                        <p class="rv-content">@rv.Content</p>
                        @if (!string.IsNullOrWhiteSpace(rv.AdminReply))
                        {
                            <div class="rv-reply">
                                <div class="rv-reply-head"><i class="bi bi-shop" aria-hidden="true"></i> Phản hồi từ shop</div>
                                <p class="rv-reply-content">@rv.AdminReply</p>
                            </div>
                        }
                    </article>
                }
            }
        </div>

        @*
            Form gửi đánh giá — AJAX, kết quả báo qua JS (đánh giá chờ duyệt nên PDP không đổi ngay).

            Giai đoạn 9: CHỈ hiện cho tài khoản đã MUA XONG sản phẩm này. Ba trạng thái, mỗi
            trạng thái nói rõ người xem cần làm gì tiếp — thay vì lặng lẽ giấu form đi khiến họ
            tưởng chức năng bị hỏng.
        *@
        @if (canReview)
        {
            <form class="rv-form" id="reviewForm">
                <h3 class="rv-form-title">Viết đánh giá của bạn</h3>
                <p class="rv-note mt-0 mb-3">
                    <i class="bi bi-patch-check-fill text-success"></i>
                    Bạn đã mua sản phẩm này — đánh giá của bạn sẽ có huy hiệu <strong>Đã mua hàng</strong>.
                </p>

                <div class="rv-field">
                    <span class="rv-label">Đánh giá của bạn</span>
                    <div class="rv-star-input" id="reviewStars" role="radiogroup" aria-label="Chọn số sao">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <button type="button" class="rv-star-btn" data-value="@i" role="radio" aria-checked="false" aria-label="@i sao">
                                <i class="bi bi-star" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                </div>

                @* Ô "Tên hiển thị" đã BỎ (Giai đoạn 9): tên lấy từ hồ sơ tài khoản. Cho người gửi
                   tự khai tên là mở đường mạo danh khách khác dưới một đánh giá đã được duyệt. *@

                <div class="rv-field">
                    <label class="rv-label" for="rvPhone">Số điện thoại <span class="rv-optional">(không bắt buộc)</span></label>
                    <input class="rz-input" id="rvPhone" name="phone" type="tel" maxlength="30" inputmode="tel"
                           placeholder="Để trống sẽ dùng số của tài khoản" autocomplete="tel" />
                    <span class="rv-hint">Số điện thoại chỉ shop nhìn thấy, không hiển thị công khai.</span>
                </div>

                <div class="rv-field">
                    <label class="rv-label" for="rvContent">Nội dung</label>
                    <textarea class="rz-input" id="rvContent" name="content" rows="4" maxlength="2000"
                              placeholder="Chia sẻ cảm nhận của bạn về sản phẩm (tối thiểu 10 ký tự)"></textarea>
                </div>

                @* Honeypot — ẩn bằng CSS, người thật không điền *@
                <div class="hp-field" aria-hidden="true">
                    <label>Website<input type="text" name="rvWebsite" tabindex="-1" autocomplete="off" /></label>
                </div>

                <p class="rv-note">Đánh giá sẽ hiển thị sau khi được shop duyệt.</p>

                <button class="btn-rz btn-buy rv-submit" type="submit" id="reviewSubmit">Gửi đánh giá</button>
            </form>
        }
        else if (hasReviewedAll)
        {
            @* Mỗi lần mua chỉ đánh giá một lần (Giai đoạn 10) — mua thêm đơn mới thì lại đánh giá được *@
            <div class="rv-form rv-locked">
                <h3 class="rv-form-title"><i class="bi bi-patch-check"></i> Bạn đã đánh giá sản phẩm này</h3>
                <p class="rv-note mb-0">
                    Cảm ơn bạn đã chia sẻ! Mỗi lần mua được đánh giá một lần. Bạn xem lại đánh giá
                    của mình trong trang chi tiết đơn hàng.
                </p>
                <a class="btn-rz btn-cart-outline mt-3" href="/tai-khoan/don-hang">
                    <i class="bi bi-receipt"></i> Xem đơn hàng của tôi
                </a>
            </div>
        }
        else if (isLoggedIn)
        {
            <div class="rv-form rv-locked">
                <h3 class="rv-form-title"><i class="bi bi-lock"></i> Chỉ khách đã mua mới đánh giá được</h3>
                <p class="rv-note mb-0">
                    Shop chỉ nhận đánh giá từ người đã mua và nhận sản phẩm này, để những nhận xét
                    ở đây luôn là trải nghiệm thật. Nếu bạn vừa nhận hàng, hãy đợi shop cập nhật
                    đơn sang <strong>“Hoàn thành”</strong> rồi quay lại nhé.
                </p>
                <a class="btn-rz btn-cart-outline mt-3" href="/tai-khoan/don-hang">
                    <i class="bi bi-receipt"></i> Xem đơn hàng của tôi
                </a>
            </div>
        }
        else
        {
            <div class="rv-form rv-locked">
                <h3 class="rv-form-title"><i class="bi bi-person-circle"></i> Đăng nhập để đánh giá</h3>
                <p class="rv-note mb-0">
                    Đăng nhập bằng tài khoản đã mua sản phẩm này để chia sẻ cảm nhận của bạn.
                </p>
                <button class="btn-rz btn-buy js-auth-open mt-3" type="button">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                </button>
            </div>
        }
    </section>

    @* SẢN PHẨM LIÊN QUAN *@
    @if (Model.Related.Count > 0)
    {
        <section class="pdp-related reveal">
            @await Html.PartialAsync("_SectionHeader", new SectionHeader("Sản phẩm liên quan", "Có thể bạn quan tâm"))
            <div class="swiper related-swiper">
                <div class="swiper-wrapper">
                    @foreach (var rp in Model.Related)
                    {
                        <div class="swiper-slide">
                            @await Html.PartialAsync("_ProductCard", rp)
                        </div>
                    }
                </div>
                <button class="carousel-nav related-prev" type="button" aria-label="Trước"><i class="bi bi-chevron-left"></i></button>
                <button class="carousel-nav related-next" type="button" aria-label="Sau"><i class="bi bi-chevron-right"></i></button>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script src="~/lib/swiper/swiper-bundle.min.js"></script>
    <script src="~/js/product.js" asp-append-version="true"></script>
}
