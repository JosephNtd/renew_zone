@model LoginInput
@{
    ViewData["Title"] = "Đăng nhập";
    // Trang tài khoản không có gì cho công cụ tìm kiếm, và không nên nằm trong kết quả tìm kiếm
    ViewData["Seo"] = new RenewZone.Web.Models.SeoData
    {
        Title = "Đăng nhập",
        Description = "Đăng nhập tài khoản để mua hàng và theo dõi đơn hàng của bạn.",
        NoIndex = true
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="container auth-page">
    <div class="auth-card">
        <div class="auth-card-head">
            <div class="auth-card-icon"><i class="bi bi-person-fill"></i></div>
            <h1 class="auth-card-title">Đăng nhập</h1>
            <p class="auth-card-sub">Dùng số điện thoại bạn đã đăng ký</p>
        </div>

        <div class="auth-card-body">
            @* Đang đăng nhập sẵn bằng tài khoản khác — nói rõ để không ai bối rối vì sao vào
               đây mà header lại hiện tên người khác. Đăng nhập tiếp là THAY tài khoản hiện tại. *@
            @if (ViewData["CurrentAccount"] is string current)
            {
                <div class="auth-note mb-3">
                    <i class="bi bi-info-circle"></i>
                    Bạn đang đăng nhập bằng <strong>@current</strong>.
                    Đăng nhập tài khoản khác sẽ thoát khỏi tài khoản này.
                    <a href="/tai-khoan">Về tài khoản của tôi</a>
                </div>
            }

            <form method="post" action="/dang-nhap" asp-antiforgery="true">
                <input type="hidden" asp-for="ReturnUrl" />

                @* Lỗi cấp form (sai mật khẩu, khóa tài khoản) — lỗi từng ô hiện ngay dưới ô đó *@
                <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

                <div class="rz-field">
                    <label class="co-label" asp-for="Phone"></label>
                    <input class="rz-input" asp-for="Phone" type="tel" inputmode="tel"
                           autocomplete="username" placeholder="VD: 0912345678" autofocus />
                    <span class="co-error" asp-validation-for="Phone"></span>
                </div>

                <div class="rz-field">
                    <label class="co-label" asp-for="Password"></label>
                    <div class="auth-pass">
                        <input class="rz-input" asp-for="Password" autocomplete="current-password"
                               placeholder="Nhập mật khẩu" />
                        <button class="auth-pass-toggle" type="button" aria-label="Hiện mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span class="co-error" asp-validation-for="Password"></span>
                </div>

                <div class="auth-row">
                    <label class="d-flex align-items-center gap-2">
                        <input type="checkbox" asp-for="RememberMe" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                </div>

                <button class="btn-rz btn-buy w-100" type="submit">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                </button>
            </form>

            <p class="auth-foot">
                Chưa có tài khoản?
                <a asp-controller="Auth" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký ngay</a>
            </p>

            @* Chưa có luồng khôi phục mật khẩu tự động (site chưa cấu hình gửi email/SMS —
               quyết định 2026-07-28: admin cấp lại trong trang quản trị). Nói thẳng cho khách
               biết phải làm gì, thay vì để họ bấm vào một nút "Quên mật khẩu" chẳng dẫn tới đâu. *@
            <div class="auth-note">
                <i class="bi bi-info-circle"></i>
                Quên mật khẩu? Vui lòng gọi hotline để shop hỗ trợ cấp lại mật khẩu mới.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Nút con mắt hiện/ẩn mật khẩu — cùng hành vi với hộp thoại đăng nhập ở auth.js
        document.querySelectorAll(".auth-pass-toggle").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var input = btn.parentElement.querySelector("input");
                if (!input) return;
                var show = input.type === "password";
                input.type = show ? "text" : "password";
                btn.querySelector("i").className = show ? "bi bi-eye-slash" : "bi bi-eye";
                btn.setAttribute("aria-label", show ? "Ẩn mật khẩu" : "Hiện mật khẩu");
            });
        });
    </script>
}
