@model Product
@inject RenewZone.Domain.Interfaces.ISiteContentService SiteContent
@inject RenewZone.Domain.Interfaces.IWishlistService Wishlist
@{
    var mainImg = Model.Images.FirstOrDefault(i => i.IsMain) ?? Model.Images.FirstOrDefault();
    var imgUrl = mainImg?.Url ?? "/images/placeholder-product.svg";

    int? discountPct = Model.HasDiscount
        ? (int)Math.Round((1 - (double)(Model.SalePrice!.Value / Model.OriginalPrice)) * 100)
        : null;

    // Chỉ sản phẩm "Liên hệ" cần số hotline cho nút gọi — settings đã được cache ở tầng service.
    string hotlineTel = "";
    if (Model.IsContactPrice)
    {
        var settings = await SiteContent.GetSettingsAsync();
        var hotline = settings.GetValueOrDefault(SettingKeys.Hotline) ?? "";
        hotlineTel = "tel:" + hotline.Replace(".", "").Replace(" ", "");
    }

    // Nút ♡ (Giai đoạn 9). Tập id đã thích được nhớ trong HttpContext.Items nên trang 12 card
    // vẫn chỉ tốn 1 truy vấn. Khách vãng lai vẫn thấy nút — bấm vào sẽ mở hộp thoại đăng nhập,
    // như vậy họ biết tính năng tồn tại thay vì thấy một giao diện trống trải khó hiểu.
    var favoriteIds = await Wishlist.GetFavoriteIdsAsync(Context);
    var isFavorite = favoriteIds.Contains(Model.Id);
}
<article class="p-card">
    <div class="p-card-media">
        @if (Model.IsInstallment0Percent)
        {
            <span class="badge-installment p-badge-tl">Trả góp 0%</span>
        }
        @if (discountPct is > 0)
        {
            <span class="badge-off p-badge-tr">-@discountPct%</span>
        }
        <img class="p-card-img" src="@imgUrl" alt="@Model.Name" width="400" height="400" loading="lazy" decoding="async" />
        <span class="p-card-hover"><span class="p-quick">Xem nhanh <i class="bi bi-arrow-right"></i></span></span>

        <button class="js-wishlist p-card-fav @(isFavorite ? "is-on" : "")" type="button"
                data-product-id="@Model.Id"
                aria-pressed="@(isFavorite ? "true" : "false")"
                aria-label="@(isFavorite ? "Bỏ yêu thích" : "Thêm vào yêu thích")">
            <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart")"></i>
        </button>
    </div>

    <div class="p-card-body">
        <h3 class="p-card-name"><a class="stretched-link" href="/@Model.Slug">@Model.Name</a></h3>

        @if (Model.ReviewCount > 0)
        {
            <div class="p-card-rating">
                @await Html.PartialAsync("_StarRating", Model.AvgRating)
                <span class="p-card-rating-count">(@Model.ReviewCount)</span>
            </div>
        }

        @if (Model.IsContactPrice)
        {
            <div class="p-card-price"><span class="badge-contact">Liên hệ</span></div>
            <a class="p-card-call" href="@hotlineTel"><i class="bi bi-telephone-fill"></i>Gọi tư vấn</a>
        }
        else
        {
            <div class="p-card-price">
                @if (Model.HasDiscount)
                {
                    <span class="p-price-old">@Model.OriginalPrice.ToVnd()</span>
                }
                <span class="p-price-now">@Model.DisplayPrice.ToVnd()</span>
            </div>
        }
    </div>
</article>
