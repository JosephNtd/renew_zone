@using RenewZone.Domain.Entities
@using RenewZone.Domain.Enums
@using RenewZone.Domain.Interfaces
@using RenewZone.Web.Models
@inject ISiteContentService SiteContent
@inject INavigationService Nav
@*
    Menu + link footer đọc từ bảng MenuItems (Giai đoạn 5 — khử hardcode).
    Dùng @inject thẳng thay vì ViewComponent: cùng một tập dữ liệu được render 3 kiểu markup
    RẤT khác nhau (nav desktop có flyout, offcanvas có collapse id riêng, footer là 2 cột link)
    và cả 3 chỉ tồn tại trong file này — tách thành 3 ViewComponent + 3 view chỉ thêm file chứ
    không tái dùng được ở đâu. Xem CLAUDE.md mục 4.7.
*@
@{
    var settings = await SiteContent.GetSettingsAsync();
    var menuCats = await SiteContent.GetMenuCategoriesAsync();

    var mainMenu = await Nav.GetMenuAsync(MenuGroup.MainMenu);
    var footerPolicy = await Nav.GetMenuAsync(MenuGroup.FooterPolicy);
    var footerSupport = await Nav.GetMenuAsync(MenuGroup.FooterSupport);

    // Setting thiếu ⇒ lấy fallback ghi tại chỗ, KHÔNG bao giờ để lọt chuỗi rỗng ra HTML
    string S(string key, string fallback = "")
    {
        var value = settings.GetValueOrDefault(key);
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    var storeName = S(SettingKeys.StoreName, "RenewZone");

    // LOGO (admin sửa ở /admin/cau-hinh). Có ảnh ⇒ dùng ảnh; để trống ⇒ logo chữ như cũ.
    // Nền tối (chân trang, menu điện thoại) có ảnh riêng vì logo chữ sẫm sẽ chìm vào nền.
    var logoUrl = S(SettingKeys.LogoUrl);
    var logoDarkUrl = S(SettingKeys.LogoDarkUrl);

    // Logo chữ tách 3 phần để tô màu phần nhấn. Không khai báo / gõ không khớp ⇒ tô cả tên
    // (an toàn: không bao giờ ra chuỗi rỗng, không phụ thuộc dấu cách hay số từ trong tên).
    var highlight = S(SettingKeys.LogoHighlight);
    var markAt = highlight.Length > 0
        ? storeName.IndexOf(highlight, StringComparison.CurrentCultureIgnoreCase)
        : -1;
    var wordBefore = markAt >= 0 ? storeName[..markAt] : "";
    var wordMark = markAt >= 0 ? storeName.Substring(markAt, highlight.Length) : storeName;
    var wordAfter = markAt >= 0 ? storeName[(markAt + highlight.Length)..] : "";

    var hotline = S(SettingKeys.Hotline, "0900.000.000");
    var hotlineTel = "tel:" + hotline.Replace(".", "").Replace(" ", "");

    var address = S(SettingKeys.Address);
    var openHours = S(SettingKeys.OpenHours);
    var email = S(SettingKeys.Email);

    // Link social để trống thì ẩn hẳn nút — href="" sẽ trỏ về chính trang hiện tại
    var socials = new (string Url, string Icon, string Label)[]
    {
        (S(SettingKeys.FacebookUrl), "bi-facebook", "Facebook"),
        (S(SettingKeys.MessengerUrl), "bi-messenger", "Messenger"),
        (S(SettingKeys.ZaloUrl), "bi-chat-dots-fill", "Zalo"),
        (S(SettingKeys.MapUrl), "bi-geo-alt", "Bản đồ"),
    }.Where(s => !string.IsNullOrWhiteSpace(s.Url)).ToArray();

    var zaloUrl = S(SettingKeys.ZaloUrl);
    var messengerUrl = S(SettingKeys.MessengerUrl);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        // SeoData của trang (nếu có) hợp nhất với ViewData["Title"]/["MetaDescription"] cũ ⇒
        // các trang chưa nâng lên SeoData vẫn giữ nguyên title/description như trước.
        var seo = ViewData["Seo"] as SeoData ?? new SeoData();
        seo.Title ??= ViewData["Title"] as string;
        seo.Description ??= ViewData["MetaDescription"] as string;
    }
    @await Html.PartialAsync("_SeoMeta", seo)

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Nunito+Sans:wght@400;600;700&family=Pacifico&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    @* tokens.css PHẢI đứng trước site.css — chứa toàn bộ biến :root mà site.css tham chiếu *@
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @* TOPBAR *@
    <div class="topbar d-none d-md-block">
        <div class="container d-flex justify-content-between">
            <div class="topbar-item text-truncate">
                @if (!string.IsNullOrWhiteSpace(address))
                {
                    <i class="bi bi-geo-alt-fill"></i>@address
                }
            </div>
            <div class="d-flex">
                @if (!string.IsNullOrWhiteSpace(openHours))
                {
                    <div class="topbar-item"><i class="bi bi-clock-fill"></i>@openHours</div>
                }
                <div class="topbar-item"><i class="bi bi-telephone-fill"></i><a href="@hotlineTel">@hotline</a></div>
            </div>
        </div>
    </div>

    @* HEADER *@
    <header class="site-header" id="siteHeader">
        <div class="container header-inner">
            <button class="hamburger-btn d-lg-none" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-label="Mở menu">
                <i class="bi bi-list"></i>
            </button>

            <a class="brand" href="/" aria-label="@storeName - Trang chủ">
                @if (logoUrl.Length > 0)
                {
                    <img class="brand-logo" src="@logoUrl" alt="@storeName" />
                }
                else
                {
                    <span class="brand-word">@wordBefore<span class="text-brand">@wordMark</span>@wordAfter<span class="brand-dot">.</span></span>
                }
                <span class="brand-tag">@S(SettingKeys.Tagline)</span>
            </a>

            <form class="search-pill d-none d-lg-flex" action="/tim-kiem" method="get" role="search">
                <input type="search" name="q" placeholder="Bạn cần tìm gì hôm nay? (iPhone 16, MacBook M3...)" aria-label="Tìm kiếm sản phẩm" />
                <button class="search-btn" type="submit" aria-label="Tìm kiếm"><i class="bi bi-search"></i></button>
            </form>

            <div class="ms-auto d-flex align-items-center gap-3">
                <a class="hotline-box d-none d-xl-flex" href="@hotlineTel">
                    <span class="hotline-icon"><i class="bi bi-headset"></i></span>
                    <span>
                        <span class="hotline-label d-block">Hotline hỗ trợ</span>
                        <span class="hotline-number">@hotline</span>
                    </span>
                </a>

                @* TÀI KHOẢN (Giai đoạn 9) — chưa đăng nhập thì mở hộp thoại tại chỗ thay vì
                   rời trang; đã đăng nhập thì đổ ra menu các khu của tài khoản. *@
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown acc-menu">
                        <button class="acc-btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                aria-expanded="false" aria-label="Tài khoản của tôi">
                            <i class="bi bi-person-circle"></i>
                            <span class="acc-btn-text d-none d-md-inline">@User.DisplayName()</span>
                            <i class="bi bi-chevron-down acc-caret d-none d-md-inline"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end acc-dropdown">
                            <li><a class="dropdown-item" href="/tai-khoan"><i class="bi bi-speedometer2"></i>Tổng quan</a></li>
                            <li><a class="dropdown-item" href="/tai-khoan/don-hang"><i class="bi bi-receipt"></i>Đơn hàng của tôi</a></li>
                            <li><a class="dropdown-item" href="/tai-khoan/yeu-thich"><i class="bi bi-heart"></i>Sản phẩm yêu thích</a></li>
                            <li><a class="dropdown-item" href="/tai-khoan/dia-chi"><i class="bi bi-geo-alt"></i>Sổ địa chỉ</a></li>
                            <li><a class="dropdown-item" href="/tai-khoan/ho-so"><i class="bi bi-person-gear"></i>Thông tin cá nhân</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                @* Đăng xuất phải là POST + anti-forgery: để GET thì chỉ cần dụ khách
                                   mở một thẻ <img src="/dang-xuat"> là họ bị đăng xuất (CSRF). *@
                                <form method="post" action="/dang-xuat">
                                    @Html.AntiForgeryToken()
                                    <button class="dropdown-item text-danger" type="submit">
                                        <i class="bi bi-box-arrow-right"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="acc-btn js-auth-open" href="/dang-nhap" data-auth-tab="login" aria-label="Đăng nhập">
                        <i class="bi bi-person-circle"></i>
                        <span class="acc-btn-text d-none d-md-inline">Đăng nhập</span>
                    </a>
                }

                <a class="cart-btn" href="/gio-hang" aria-label="Giỏ hàng">
                    <i class="bi bi-bag-fill"></i>
                    @await Component.InvokeAsync("CartBadge")
                    <span class="d-none d-md-inline">Giỏ hàng</span>
                </a>
            </div>
        </div>

        @* Search hàng 2 — mobile/tablet *@
        <div class="header-search-mobile d-lg-none">
            <form class="search-pill" action="/tim-kiem" method="get" role="search">
                <input type="search" name="q" placeholder="Tìm iPhone, MacBook, iPad..." aria-label="Tìm kiếm sản phẩm" />
                <button class="search-btn" type="submit" aria-label="Tìm kiếm"><i class="bi bi-search"></i></button>
            </form>
        </div>
    </header>

    @* MAIN NAV (desktop) *@
    <nav class="mainnav d-none d-lg-block" aria-label="Menu chính">
        <div class="container">
            <ul class="mainnav-list">
                @foreach (var item in mainMenu)
                {
                    var isMega = item.Type == MenuItemType.ProductMega;
                    var hasPanel = isMega || item.Children.Count > 0;
                    <li class="mainnav-item">
                        <a class="mainnav-link" href="@(item.Url ?? "#")" target="@(item.OpenInNewTab ? "_blank" : null)">
                            @if (!string.IsNullOrWhiteSpace(item.Icon))
                            {
                                <i class="bi @item.Icon"></i>
                            }
                            @item.Text
                            @if (hasPanel)
                            {
                                <i class="bi bi-chevron-down"></i>
                            }
                        </a>
                        @if (isMega)
                        {
                            @* Dropdown sinh động từ cây danh mục — admin thêm danh mục là menu tự có *@
                            <div class="dd-panel">
                                @foreach (var cat in menuCats)
                                {
                                    <div class="dd-item">
                                        <a class="dd-link" href="/@cat.Slug">
                                            <i class="bi @(cat.IconClass ?? "bi-grid")"></i>@cat.Name
                                            @if (cat.Children.Count > 0)
                                            {
                                                <i class="bi bi-chevron-right"></i>
                                            }
                                        </a>
                                        @if (cat.Children.Count > 0)
                                        {
                                            <div class="dd-sub">
                                                @foreach (var child in cat.Children)
                                                {
                                                    <a class="dd-link" href="/@child.Slug">@child.Name</a>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (item.Children.Count > 0)
                        {
                            <div class="dd-panel">
                                @foreach (var child in item.Children)
                                {
                                    <a class="dd-link" href="@child.Url" target="@(child.OpenInNewTab ? "_blank" : null)">
                                        <i class="bi @(child.Icon ?? "bi-dot")"></i>@child.Text
                                    </a>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
    </nav>

    @* OFFCANVAS MENU (mobile) *@
    <div class="offcanvas offcanvas-start mobile-menu" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
        <div class="offcanvas-header">
            @if (logoDarkUrl.Length > 0)
            {
                <img class="mm-brand-logo" id="mobileMenuLabel" src="@logoDarkUrl" alt="@storeName" />
            }
            else
            {
                <span class="brand-word" id="mobileMenuLabel" style="font-size:1.2rem;color:#fff">
                    @wordBefore<span style="color:var(--brand-200)">@wordMark</span>@wordAfter<span class="brand-dot">.</span>
                </span>
            }
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body">
            @foreach (var item in mainMenu)
            {
                if (item.Type == MenuItemType.ProductMega)
                {
                    <div class="mm-group">
                        <button class="mm-link mm-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mmItem-@item.Id" aria-expanded="false">
                            <i class="bi @(item.Icon ?? "bi-grid")"></i>@item.Text <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="collapse" id="mmItem-@item.Id">
                            @foreach (var cat in menuCats)
                            {
                                if (cat.Children.Count > 0)
                                {
                                    <button class="mm-link mm-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mmCat-@cat.Id" aria-expanded="false">
                                        <i class="bi @(cat.IconClass ?? "bi-grid")"></i>@cat.Name <i class="bi bi-chevron-down"></i>
                                    </button>
                                    <div class="collapse mm-sub" id="mmCat-@cat.Id">
                                        <a class="mm-link" href="/@cat.Slug">Tất cả @cat.Name</a>
                                        @foreach (var child in cat.Children)
                                        {
                                            <a class="mm-link" href="/@child.Slug">@child.Name</a>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <a class="mm-link" href="/@cat.Slug"><i class="bi @(cat.IconClass ?? "bi-grid")"></i>@cat.Name</a>
                                }
                            }
                        </div>
                    </div>
                }
                else if (item.Children.Count > 0)
                {
                    <div class="mm-group">
                        <button class="mm-link mm-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mmItem-@item.Id" aria-expanded="false">
                            @if (!string.IsNullOrWhiteSpace(item.Icon))
                            {
                                <i class="bi @item.Icon"></i>
                            }
                            @item.Text <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="collapse mm-sub" id="mmItem-@item.Id">
                            @foreach (var child in item.Children)
                            {
                                <a class="mm-link" href="@child.Url" target="@(child.OpenInNewTab ? "_blank" : null)">@child.Text</a>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <a class="mm-link" href="@(item.Url ?? "#")" target="@(item.OpenInNewTab ? "_blank" : null)">
                        @if (!string.IsNullOrWhiteSpace(item.Icon))
                        {
                            <i class="bi @item.Icon"></i>
                        }
                        @item.Text
                    </a>
                }
            }

            <div class="mm-hotline">
                <div class="hotline-label">Hotline hỗ trợ 24/7</div>
                <a class="hotline-number" href="@hotlineTel">@hotline</a>
            </div>
        </div>
    </div>

    @* NỘI DUNG TRANG *@
    <main id="mainContent">
        @RenderBody()
    </main>

    @* FOOTER *@
    <footer class="site-footer">
        <div class="container footer-main">
            <div class="row g-4">
                <div class="col-12 col-md-6 col-lg-4">
                    @if (logoDarkUrl.Length > 0)
                    {
                        <img class="f-brand-logo mb-2" src="@logoDarkUrl" alt="@storeName" />
                    }
                    else
                    {
                        <div class="f-brand-word mb-2">@wordBefore<span class="text-brand">@wordMark</span>@wordAfter<span class="brand-dot">.</span></div>
                    }
                    <p class="mb-3">@S(SettingKeys.FooterAbout, "Cửa hàng thiết bị Apple mới và đã qua sử dụng.")</p>
                    @if (!string.IsNullOrWhiteSpace(address))
                    {
                        <div class="f-contact-item"><i class="bi bi-geo-alt-fill"></i><span>@address</span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(openHours))
                    {
                        <div class="f-contact-item"><i class="bi bi-clock-fill"></i><span>@openHours</span></div>
                    }
                    <div class="f-contact-item"><i class="bi bi-telephone-fill"></i><a class="f-link d-inline p-0" href="@hotlineTel">@hotline</a></div>
                    @if (!string.IsNullOrWhiteSpace(email))
                    {
                        <div class="f-contact-item"><i class="bi bi-envelope-fill"></i><span>@email</span></div>
                    }
                </div>

                @* Nhóm không có mục nào ⇒ ẩn cả cột, không render khung trống *@
                @if (footerPolicy.Count > 0)
                {
                    <div class="col-6 col-md-6 col-lg-3">
                        <div class="f-title">Chính sách</div>
                        @foreach (var link in footerPolicy)
                        {
                            <a class="f-link" href="@link.Url" target="@(link.OpenInNewTab ? "_blank" : null)">@link.Text</a>
                        }
                    </div>
                }

                @if (footerSupport.Count > 0)
                {
                    <div class="col-6 col-md-6 col-lg-2">
                        <div class="f-title">Hỗ trợ</div>
                        @foreach (var link in footerSupport)
                        {
                            <a class="f-link" href="@link.Url" target="@(link.OpenInNewTab ? "_blank" : null)">@link.Text</a>
                        }
                    </div>
                }

                @if (socials.Length > 0)
                {
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="f-title">Kết nối với chúng tôi</div>
                        <p class="mb-1">Theo dõi để nhận ưu đãi sớm nhất:</p>
                        <div class="f-social">
                            @foreach (var s in socials)
                            {
                                <a href="@s.Url" target="_blank" rel="noopener" aria-label="@s.Label"><i class="bi @s.Icon"></i></a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container d-flex flex-column flex-md-row justify-content-between gap-1">
                <span>© @DateTime.Now.Year @storeName · MST: @S(SettingKeys.TaxCode, "—")</span>
                <span>@S(SettingKeys.FooterDisclaimer, "Website học tập (clone).")</span>
            </div>
        </div>
    </footer>

    @* NÚT NỔI + BACK TO TOP + TOAST *@
    <div class="float-contact">
        <a class="fbtn fbtn-phone" href="@hotlineTel" aria-label="Gọi điện">
            <i class="bi bi-telephone-fill"></i>
            <span class="fbtn-tip">@hotline</span>
        </a>
        @if (!string.IsNullOrWhiteSpace(zaloUrl))
        {
            <a class="fbtn fbtn-zalo" href="@zaloUrl" target="_blank" rel="noopener" aria-label="Chat Zalo">
                Zalo
                <span class="fbtn-tip">Chat Zalo</span>
            </a>
        }
        @if (!string.IsNullOrWhiteSpace(messengerUrl))
        {
            <a class="fbtn fbtn-messenger" href="@messengerUrl" target="_blank" rel="noopener" aria-label="Chat Messenger">
                <i class="bi bi-messenger"></i>
                <span class="fbtn-tip">Chat Messenger</span>
            </a>
        }
    </div>

    <button id="backToTop" type="button" aria-label="Về đầu trang"><i class="bi bi-arrow-up"></i></button>

    <div class="toast-stack" id="toastStack" aria-live="polite"></div>

    @* MINI-CART (offcanvas, mở từ icon giỏ) *@
    @await Html.PartialAsync("_MiniCart")

    @* HỘP THOẠI ĐĂNG NHẬP/ĐĂNG KÝ (Giai đoạn 9) — chỉ dựng cho khách CHƯA đăng nhập.
       Người đã đăng nhập không bao giờ cần tới nó, render ra chỉ tổ nặng trang. *@
    @if (User.Identity?.IsAuthenticated != true)
    {
        @await Html.PartialAsync("_AuthModal")
    }

    @* Token cho các POST AJAX của cart.js (gửi qua header "RequestVerificationToken") *@
    @Html.AntiForgeryToken()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Không dùng defer: cart.js phải định nghĩa RZ.addToCart TRƯỚC các script của section bên dưới *@
    <script src="~/js/cart.js" asp-append-version="true"></script>
    @* auth.js nạp SAU cart.js: cart.js gọi RZ.requireLogin khi server báo cần đăng nhập *@
    <script src="~/js/auth.js" asp-append-version="true"></script>

    @* Realtime báo trạng thái đơn — chỉ có ý nghĩa với khách đã đăng nhập, nên không bắt
       khách vãng lai tải thêm ~130KB thư viện SignalR mà chẳng để làm gì. *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/lib/signalr/signalr.min.js"></script>
        <script src="~/js/customer-realtime.js" asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
